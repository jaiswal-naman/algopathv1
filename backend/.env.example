# ============================================
# LFA Builder Platform - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# OpenAI API Key (REQUIRED)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=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

# Database URL
# SQLite (development): sqlite:///./lfa_builder.db
# PostgreSQL (production): postgresql://user:password@localhost:5432/lfa_builder
DATABASE_URL=sqlite:///./lfa_builder.db

# Pinecone Vector Database (OPTIONAL - enables semantic template search)
# Without this, the app uses demo templates as fallback
# Get yours at: https://www.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=lfa-templates
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Frontend URL (for CORS - comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

# Model Configuration (optional - defaults shown)
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=90

# Session Configuration
SESSION_TTL_HOURS=24
